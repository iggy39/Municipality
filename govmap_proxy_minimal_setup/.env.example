GOVMAP_CONFIG_PATH=govmaps.md
GOVMAP_BASE_URL=https://www.govmap.gov.il
GOVMAP_ALLOWED_HOSTS=www.govmap.gov.il,es.govmap.gov.il

# Leave empty to pass the key as a query parameter named "apikey".
# If GovMap expects a different key name, change GOVMAP_API_KEY_PARAM.
GOVMAP_API_KEY_PARAM=apikey
GOVMAP_API_KEY_HEADER=

# Optional defaults for the named proxy endpoints.
# Requests may also pass a "path" field in the JSON body.
GOVMAP_SEARCH_PATH=
GOVMAP_SPATIAL_PATH=
GOVMAP_LOOKUP_PATH=

# Browser-native iframe API should only be used from approved origins.
GOVMAP_ALLOWED_IFRAME_ORIGINS=https://horizonscanninglab.org,https://dev.horizonscanninglab.org

# Browser callers allowed to use this backend from a separate frontend dev server.
APP_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,https://horizonscanninglab.org,https://dev.horizonscanninglab.org
